# Copy to .env.local and fill in. Also set these in Vercel → Project → Settings → Environment Variables.

# Google Tag Manager container ID (GTM-…). Leave empty to turn tracking off, e.g. for local testing.
NEXT_PUBLIC_GTM_ID=

# Google Search Console verification code (the content="…" value from the "HTML tag" method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
